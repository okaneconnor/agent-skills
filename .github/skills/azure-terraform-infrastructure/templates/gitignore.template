# =============================================================================
# Terraform
# =============================================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (uncomment if you want to commit lock files)
# .terraform.lock.hcl

# =============================================================================
# IDE and Editor
# =============================================================================

.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# Secrets and Credentials
# =============================================================================

# Sensitive variable files
secrets.tfvars
*.secret
*.secrets
.env
.env.*

# SSH keys
*.pem
*.key
id_rsa*

# Azure credentials
azure.conf
azureauth.json

# =============================================================================
# Terraform Plan Output
# =============================================================================

# Plan files
*.tfplan
tfplan
tfplan.*

# =============================================================================
# Logs
# =============================================================================

*.log
logs/
